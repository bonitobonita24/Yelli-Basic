// Yelli Phase 4 Part 3 — Prisma schema
// Source of truth for field names: packages/shared/src/entities.ts (S1 LOCKED contract).
// Tenancy: multi-mode (Cloud); single-implicit slug="default" (LAN). Every tenant-scoped
//   model carries tenantId NOT NULL with an index. L2 RLS policies live in the initial
//   migration SQL (prisma/migrations/0001_init/migration.sql), not in this schema file.
// AuditAction: 29 §11-canonical values stored as String (Prisma enums reject dots, e.g.
//   "device.role.assign"); the locked vocabulary lives in @yelli/shared AUDIT_ACTIONS.
// AuditLog.tenantId + targetId are nullable to permit platform-level superadmin actions
//   and targetless events (e.g. "lan.admin.login.success") — LOCKED: AuditLog.targetId nullability.
// User.securityVersion: Int @default(0) — security.md §AUTH DEFAULTS #6 (session-invalidation
//   on role/tenant/status/password change). LOCKED: User.securityVersion field.
// Argon2id vs bcrypt: User.passwordHash = bcrypt; Tenant.adminPassphraseHash = Argon2id.
// EndReason: TS literals use hyphens; Prisma enum values use underscores + @map.
// CallSession.endedAt + durationSec: nullable (null until the call ends — matches
//   packages/shared/src/entities.ts: endedAt: Date | null, durationSec: number | null).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  admin
  member
}

enum CallRole {
  both
  caller
  receiver
}

enum AuditTargetType {
  User
  Tenant
  Invitation
  Device
  ExportJob
}

// EndReason: Prisma enum values cannot contain hyphens.
// DB values use underscores; TS strings with hyphens map via @map on each value.
enum EndReason {
  completed
  declined
  busy
  no_answer         @map("no-answer")
  peer_disconnect   @map("peer-disconnect")
  ice_failed        @map("ice-failed")
  cancelled
  forbidden_by_role @map("forbidden-by-role")
}

enum ExportJobStatus {
  queued
  processing
  ready
  expired
}

// ─── Core domain models ───────────────────────────────────────────────────────

model Tenant {
  id                  String   @id @default(cuid())
  slug                String   @unique
  displayName         String
  logoUrl             String?
  isSuspended         Boolean  @default(false)
  /// Argon2id hash — LAN Anonymous Admin only; null on Cloud tenants
  adminPassphraseHash String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users                User[]
  devices              Device[]
  invitations          Invitation[]
  auditLogs            AuditLog[]
  callSessions         CallSession[]
  webPushSubscriptions WebPushSubscription[]
  exportJobs           ExportJob[]

  @@map("tenants")
}

model User {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  email           String
  emailVerifiedAt DateTime? @map("email_verified_at")
  passwordHash    String    @map("password_hash")
  displayName     String    @map("display_name")
  role            Role      @default(member)
  isSuspended     Boolean   @default(false) @map("is_suspended")
  /// Incremented on role/tenant/status/password change; Auth.js session() callback
  /// blanks the session when the JWT-embedded version differs (security.md §AUTH #6).
  securityVersion Int       @default(0) @map("security_version")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  devicesOwned         Device[]
  invitationsCreated   Invitation[]
  auditLogs            AuditLog[]
  webPushSubscriptions WebPushSubscription[]
  exportJobsRequested  ExportJob[]
  // Auth.js relations
  sessions             Session[]
  accounts             Account[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Device {
  id                 String    @id @default(cuid())
  tenantId           String    @map("tenant_id")
  userId             String?   @map("user_id")
  displayName        String    @map("display_name")
  callRole           CallRole  @default(both) @map("call_role")
  browserFingerprint String    @map("browser_fingerprint")
  assignedRoleAt     DateTime? @map("assigned_role_at")
  lastSeenAt         DateTime  @default(now()) @map("last_seen_at")
  archivedAt         DateTime? @map("archived_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  owner                User?                 @relation(fields: [userId], references: [id])
  callsAsCaller        CallSession[]         @relation("CallerDevice")
  callsAsCallee        CallSession[]         @relation("CalleeDevice")
  webPushSubscriptions WebPushSubscription[]

  @@index([tenantId])
  @@index([tenantId, archivedAt])
  @@map("devices")
}

model Invitation {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  invitedByUserId String    @map("invited_by_user_id")
  email           String
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  invitedBy User   @relation(fields: [invitedByUserId], references: [id])

  @@index([tenantId])
  @@map("invitations")
}

model AuditLog {
  id          String          @id @default(cuid())
  /// Nullable: superadmin platform-level actions have no tenant scope
  tenantId    String?         @map("tenant_id")
  /// Nullable: system-generated events (cron, automated jobs) have no actor
  actorUserId String?         @map("actor_user_id")
  /// §11-canonical action strings stored as plain String (values contain dots, e.g. "device.role.assign")
  action      String
  targetType  AuditTargetType @map("target_type")
  /// Nullable: targetless events (e.g. "lan.admin.login.success", "pwa.install") have no target
  targetId    String?         @map("target_id")
  payload     Json?
  createdAt   DateTime        @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  actor  User?   @relation(fields: [actorUserId], references: [id])

  @@index([tenantId])
  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model CallSession {
  id               String     @id @default(cuid())
  tenantId         String     @map("tenant_id")
  callerDeviceId   String     @map("caller_device_id")
  calleeDeviceId   String     @map("callee_device_id")
  callerRoleAtCall CallRole   @map("caller_role_at_call")
  calleeRoleAtCall CallRole   @map("callee_role_at_call")
  startedAt        DateTime   @map("started_at")
  connectedAt      DateTime?  @map("connected_at")
  endedAt          DateTime?  @map("ended_at")
  durationSec      Int?       @map("duration_sec")
  endReason        EndReason? @map("end_reason")

  tenant       Tenant @relation(fields: [tenantId], references: [id])
  callerDevice Device @relation("CallerDevice", fields: [callerDeviceId], references: [id])
  calleeDevice Device @relation("CalleeDevice", fields: [calleeDeviceId], references: [id])

  @@index([tenantId])
  @@index([tenantId, startedAt])
  @@map("call_sessions")
}

model WebPushSubscription {
  id         String    @id @default(cuid())
  /// Nullable: platform-level push (admin broadcast) has no tenant scope
  tenantId   String?   @map("tenant_id")
  /// Nullable: device-only subscriptions (pre-auth) have no userId
  userId     String?   @map("user_id")
  deviceId   String    @map("device_id")
  endpoint   String    @unique
  p256dh     String
  auth       String
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])
  device Device  @relation(fields: [deviceId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("web_push_subscriptions")
}

model ExportJob {
  id                String          @id @default(cuid())
  tenantId          String          @map("tenant_id")
  /// Nullable: a system/cron-initiated export has no requesting user
  requestedByUserId String?         @map("requested_by_user_id")
  status            ExportJobStatus @default(queued)
  requestedAt       DateTime        @default(now()) @map("requested_at")
  readyAt           DateTime?       @map("ready_at")
  /// Signed-URL TTL (24h per LOCKED Jobs + Queues)
  expiresAt         DateTime?       @map("expires_at")
  signedUrl         String?         @map("signed_url")
  downloadedAt      DateTime?       @map("downloaded_at")
  payloadBytes      Int?            @map("payload_bytes")

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  requestedBy User?  @relation(fields: [requestedByUserId], references: [id])

  @@index([tenantId])
  @@map("export_jobs")
}

// ─── Auth.js v5 adapter tables ────────────────────────────────────────────────
// Ref: https://authjs.dev/getting-started/adapters/prisma
// LOCKED: Auth.js v5 ships Credentials + JWT only (no PrismaAdapter) — these tables
// stay empty until Phase 7 adds magic-link / email-link providers (which need the adapter).

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
