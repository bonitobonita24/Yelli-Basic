// Yelli Phase 4 Part 3 — Prisma schema
// Source of truth for field names: packages/shared/src/entities.ts (S1 LOCKED contract).
// Tenancy: multi-mode (Cloud); single-implicit slug="default" (LAN). Every tenant-scoped
//   model carries tenantId NOT NULL with an index. L2 RLS policies live in the initial
//   migration SQL (prisma/migrations/0001_init/migration.sql), not in this schema file.
// AuditAction: 29 §11-canonical values stored as String (Prisma enums reject dots, e.g.
//   "device.role.assign"); the locked vocabulary lives in @yelli/shared AUDIT_ACTIONS.
// AuditLog.tenantId + targetId are nullable to permit platform-level superadmin actions
//   and targetless events (e.g. "lan.admin.login.success") — LOCKED: AuditLog.targetId nullability.
// User.securityVersion: Int @default(0) — security.md §AUTH DEFAULTS #6 (session-invalidation
//   on role/tenant/status/password change). LOCKED: User.securityVersion field.
// Argon2id vs bcrypt: User.passwordHash = bcrypt; Tenant.adminPassphraseHash = Argon2id.
// EndReason: TS literals use hyphens; Prisma enum values use underscores + @map.
// CallSession.endedAt + durationSec: nullable (null until the call ends — matches
//   packages/shared/src/entities.ts: endedAt: Date | null, durationSec: number | null).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  admin
  member
}

enum CallRole {
  both
  caller
  receiver
}

enum AuditTargetType {
  User
  Tenant
  Invitation
  Device
  ExportJob
  // V32.9 — compliance models
  DataSubjectRequest
  BreachNotificationRecord
  ConsentLog
}

// ─── V32.9 Privacy / Compliance enums ─────────────────────────────────────────
// PH Data Privacy Act (RA 10173) + NPC IRR — lawful bases for personal-data processing.
enum LawfulBasis {
  CONSENT
  CONTRACT
  LEGAL_OBLIGATION
  LEGITIMATE_INTEREST
  VITAL_INTEREST
  PUBLIC_AUTHORITY
}

// The 6 data-subject rights under RA 10173 §16 + NPC IRR Rule XI.
enum DsrType {
  INFORM
  OBJECT
  ACCESS
  RECTIFY
  ERASE
  PORT
}

enum DsrStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

// Breach notification statuses (NPC Circular 16-03: 72h initial + 5 business-day written report).
enum BreachStatus {
  DETECTED
  ASSESSED
  NOTIFIED
  REPORTED
  CLOSED
}

enum BreachSeverity {
  LOW
  MEDIUM
  HIGH
}

// EndReason: Prisma enum values cannot contain hyphens.
// DB values use underscores; TS strings with hyphens map via @map on each value.
enum EndReason {
  completed
  declined
  busy
  no_answer         @map("no-answer")
  peer_disconnect   @map("peer-disconnect")
  ice_failed        @map("ice-failed")
  cancelled
  forbidden_by_role @map("forbidden-by-role")
}

enum ExportJobStatus {
  queued
  processing
  ready
  expired
}

// ─── Core domain models ───────────────────────────────────────────────────────

model Tenant {
  id                  String   @id @default(cuid())
  slug                String   @unique
  displayName         String
  logoUrl             String?
  isSuspended         Boolean  @default(false)
  /// Argon2id hash — LAN Anonymous Admin only; null on Cloud tenants
  adminPassphraseHash String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users                     User[]
  devices                   Device[]
  invitations               Invitation[]
  auditLogs                 AuditLog[]
  callSessions              CallSession[]
  webPushSubscriptions      WebPushSubscription[]
  exportJobs                ExportJob[]
  // V32.9 compliance relations
  consentLogs               ConsentLog[]
  dataSubjectRequests       DataSubjectRequest[]
  breachNotificationRecords BreachNotificationRecord[]
  retentionPolicies         RetentionPolicy[]

  @@map("tenants")
}

model User {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  email           String
  emailVerifiedAt DateTime? @map("email_verified_at")
  passwordHash    String    @map("password_hash")
  displayName     String    @map("display_name")
  role            Role      @default(member)
  isSuspended     Boolean   @default(false) @map("is_suspended")
  /// Incremented on role/tenant/status/password change; Auth.js session() callback
  /// blanks the session when the JWT-embedded version differs (security.md §AUTH #6).
  securityVersion Int       @default(0) @map("security_version")
  lastLoginAt     DateTime? @map("last_login_at")
  /// Set by removeMember alongside isSuspended=true. The 7-day soft-delete cron
  /// hard-deletes users where removedAt < now()-7d (DECISIONS_LOG q-W5-01).
  removedAt       DateTime? @map("removed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant                      Tenant                     @relation(fields: [tenantId], references: [id])
  devicesOwned                Device[]
  invitationsCreated          Invitation[]
  auditLogs                   AuditLog[]
  webPushSubscriptions        WebPushSubscription[]
  exportJobsRequested         ExportJob[]
  // Auth.js relations
  sessions                    Session[]
  accounts                    Account[]
  // V32.9 compliance relations
  consentLogs                 ConsentLog[]
  dataSubjectRequests         DataSubjectRequest[]
  breachNotificationsRecorded BreachNotificationRecord[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Device {
  id                 String    @id @default(cuid())
  tenantId           String    @map("tenant_id")
  userId             String?   @map("user_id")
  displayName        String    @map("display_name")
  callRole           CallRole  @default(both) @map("call_role")
  browserFingerprint String    @map("browser_fingerprint")
  assignedRoleAt     DateTime? @map("assigned_role_at")
  lastSeenAt         DateTime  @default(now()) @map("last_seen_at")
  archivedAt         DateTime? @map("archived_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  owner                User?                 @relation(fields: [userId], references: [id])
  callsAsCaller        CallSession[]         @relation("CallerDevice")
  callsAsCallee        CallSession[]         @relation("CalleeDevice")
  webPushSubscriptions WebPushSubscription[]

  @@index([tenantId])
  @@index([tenantId, archivedAt])
  @@map("devices")
}

model Invitation {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  /// Nullable: LAN-admin invites have no `users` row (synthetic `__lan_admin__` actor → null)
  invitedByUserId String?   @map("invited_by_user_id")
  email           String
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  invitedBy User?  @relation(fields: [invitedByUserId], references: [id])

  @@index([tenantId])
  @@map("invitations")
}

model AuditLog {
  id          String          @id @default(cuid())
  /// Nullable: superadmin platform-level actions have no tenant scope
  tenantId    String?         @map("tenant_id")
  /// Nullable: system-generated events (cron, automated jobs) have no actor
  actorUserId String?         @map("actor_user_id")
  /// §11-canonical action strings stored as plain String (values contain dots, e.g. "device.role.assign")
  action      String
  targetType  AuditTargetType @map("target_type")
  /// Nullable: targetless events (e.g. "lan.admin.login.success", "pwa.install") have no target
  targetId    String?         @map("target_id")
  payload     Json?
  createdAt   DateTime        @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  actor  User?   @relation(fields: [actorUserId], references: [id])

  @@index([tenantId])
  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model CallSession {
  id               String     @id @default(cuid())
  tenantId         String     @map("tenant_id")
  callerDeviceId   String     @map("caller_device_id")
  calleeDeviceId   String     @map("callee_device_id")
  callerRoleAtCall CallRole   @map("caller_role_at_call")
  calleeRoleAtCall CallRole   @map("callee_role_at_call")
  startedAt        DateTime   @map("started_at")
  connectedAt      DateTime?  @map("connected_at")
  endedAt          DateTime?  @map("ended_at")
  durationSec      Int?       @map("duration_sec")
  endReason        EndReason? @map("end_reason")

  tenant       Tenant @relation(fields: [tenantId], references: [id])
  callerDevice Device @relation("CallerDevice", fields: [callerDeviceId], references: [id])
  calleeDevice Device @relation("CalleeDevice", fields: [calleeDeviceId], references: [id])

  @@index([tenantId])
  @@index([tenantId, startedAt])
  @@map("call_sessions")
}

model WebPushSubscription {
  id         String    @id @default(cuid())
  /// Nullable: platform-level push (admin broadcast) has no tenant scope
  tenantId   String?   @map("tenant_id")
  /// Nullable: device-only subscriptions (pre-auth) have no userId
  userId     String?   @map("user_id")
  deviceId   String    @map("device_id")
  endpoint   String    @unique
  p256dh     String
  auth       String
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])
  device Device  @relation(fields: [deviceId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("web_push_subscriptions")
}

model ExportJob {
  id                String          @id @default(cuid())
  tenantId          String          @map("tenant_id")
  /// Nullable: a system/cron-initiated export has no requesting user
  requestedByUserId String?         @map("requested_by_user_id")
  status            ExportJobStatus @default(queued)
  requestedAt       DateTime        @default(now()) @map("requested_at")
  readyAt           DateTime?       @map("ready_at")
  /// Signed-URL TTL (24h per LOCKED Jobs + Queues)
  expiresAt         DateTime?       @map("expires_at")
  signedUrl         String?         @map("signed_url")
  downloadedAt      DateTime?       @map("downloaded_at")
  payloadBytes      Int?            @map("payload_bytes")

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  requestedBy User?  @relation(fields: [requestedByUserId], references: [id])

  @@index([tenantId])
  @@map("export_jobs")
}

// ─── V32.9 Compliance models ──────────────────────────────────────────────────
// PH Data Privacy Act (RA 10173) + NPC IRR.  Every model carries tenantId (L6).

/// Records consent for a processing activity — one row per grant/withdrawal per purpose.
model ConsentLog {
  id            String      @id @default(cuid())
  tenantId      String      @map("tenant_id")
  userId        String      @map("user_id")
  /// Processing activity being consented to (e.g. "analytics", "marketing-email").
  purpose       String
  lawfulBasis   LawfulBasis @map("lawful_basis")
  /// Version of the privacy notice shown at grant time.
  noticeVersion String      @map("notice_version")
  granted       Boolean
  grantedAt     DateTime    @default(now()) @map("granted_at")
  withdrawnAt   DateTime?   @map("withdrawn_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, userId])
  @@map("consent_logs")
}

/// Tracks each data-subject request (access / rectify / erase / port / inform / object).
/// dueAt = requestedAt + 15 calendar days (NPC's reasonable response period for most DSRs).
model DataSubjectRequest {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  userId      String    @map("user_id")
  type        DsrType   @map("type")
  status      DsrStatus @default(RECEIVED) @map("status")
  requestedAt DateTime  @default(now()) @map("requested_at")
  /// NPC reasonable period: 15 calendar days from request receipt (comment: adjust per NPC advisory).
  dueAt       DateTime  @map("due_at")
  resolvedAt  DateTime? @map("resolved_at")
  /// URL to the export artifact or action record (e.g. signed S3 URL for PORT).
  evidenceUrl String?   @map("evidence_url")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, userId])
  @@map("data_subject_requests")
}

/// Records a personal-data breach incident per NPC Circular 16-03.
/// writtenReportDueAt is pre-computed at creation: detectedAt + 72h + 5 business days.
model BreachNotificationRecord {
  id                       String         @id @default(cuid())
  tenantId                 String         @map("tenant_id")
  severity                 BreachSeverity @map("severity")
  status                   BreachStatus   @default(DETECTED) @map("status")
  detectedAt               DateTime       @map("detected_at")
  /// NPC must be notified within 72 hours of detection (NPC Circular 16-03 §5).
  npcNotifiedAt            DateTime?      @map("npc_notified_at")
  subjectsNotifiedAt       DateTime?      @map("subjects_notified_at")
  /// Full written report due within 5 business days after the initial 72h notification.
  /// Stored pre-computed at creation time so reminders / SLA checks are cheap.
  writtenReportDueAt       DateTime       @map("written_report_due_at")
  writtenReportSubmittedAt DateTime?      @map("written_report_submitted_at")
  /// Number of data subjects whose records were exposed.
  affectedUserCount        Int            @map("affected_user_count")
  description              String
  /// Nullable: system-detected breaches may have no human recorder initially.
  recordedByUserId         String?        @map("recorded_by_user_id")

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  recordedBy User?  @relation(fields: [recordedByUserId], references: [id])

  @@index([tenantId])
  @@index([tenantId, detectedAt])
  @@map("breach_notification_records")
}

/// Per-entity retention policy. retainDays = 0 means "delete immediately after purpose expires".
/// Legal-hold entities (e.g. AuditLog 7yr, CallSession 1yr) set legalHold=true and retainDays accordingly.
model RetentionPolicy {
  id         String  @id @default(cuid())
  tenantId   String  @map("tenant_id")
  /// Model / table this policy governs (e.g. "AuditLog", "CallSession", "User").
  entity     String
  retainDays Int     @map("retain_days")
  /// True for legally-required retention (overrides DSR erase for that entity).
  legalHold  Boolean @default(false) @map("legal_hold")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, entity])
  @@index([tenantId])
  @@map("retention_policies")
}

// ─── Auth.js v5 adapter tables ────────────────────────────────────────────────
// Ref: https://authjs.dev/getting-started/adapters/prisma
// LOCKED: Auth.js v5 ships Credentials + JWT only (no PrismaAdapter) — these tables
// stay empty until Phase 7 adds magic-link / email-link providers (which need the adapter).

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
