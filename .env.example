# ═══════════════════════════════════════════════════════════════════
# Yelli — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════
# HOW TO USE:
#   cp .env.example .env.dev    (then fill real values, or use sync script)
#   cp .env.example .env.staging
#   cp .env.example .env.prod
#
# NEVER commit .env.dev, .env.staging, or .env.prod to git.
# NEVER commit CREDENTIALS.md (it is gitignored).
# Real secrets live in CREDENTIALS.md — run scripts/sync-credentials-to-env.sh
# to propagate filled CREDENTIALS.md values into your env files.
#
# FIRST ADMIN ACCOUNT (created by pnpm db:seed):
#   Email:    bonitobonita24@gmail.com
#   Password: see CREDENTIALS.md under "First Admin Account"
#   URL:      http://localhost:46848/login   (dev port)
# ═══════════════════════════════════════════════════════════════════

COMPOSE_PROJECT_NAME=yelli_dev
APP_ENV=development|staging|production
APP_PORT=46848

# DATABASE
DB_HOST=localhost
DB_PORT=46838
DB_NAME=yelli_dev
DB_USER=yelli_dev_your-hex-suffix-here
DB_PASSWORD=your-db-password-here
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# PGBOUNCER
PGBOUNCER_PORT=46839
PGBOUNCER_AUTH_PASSWORD=your-pgbouncer-password-here
PGBOUNCER_DATABASE_URL=postgresql://${DB_USER}:${PGBOUNCER_AUTH_PASSWORD}@localhost:${PGBOUNCER_PORT}/${DB_NAME}

# CACHE (Valkey)
REDIS_HOST=localhost
REDIS_PORT=46840
REDIS_PASSWORD=your-redis-password-here
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# STORAGE (MinIO — S3-compatible)
STORAGE_ENDPOINT=http://localhost:46841
STORAGE_CONSOLE_PORT=46842
STORAGE_BUCKET=yelli-dev
STORAGE_ACCESS_KEY=yelli-dev-your-access-key-suffix
STORAGE_SECRET_KEY=your-storage-secret-key-here
STORAGE_REGION=us-east-1

# AUTH (Auth.js v5)
AUTH_SECRET=your-48-char-auth-secret-here
NEXTAUTH_URL=http://localhost:46848

# EMAIL (dev uses MailHog; staging/prod use real SMTP)
SMTP_HOST=localhost
SMTP_PORT=46843
SMTP_USER=
SMTP_PASSWORD=your-smtp-password-here
SMTP_FROM=noreply@yelli.app

# PGADMIN
PGADMIN_PORT=46845
PGADMIN_EMAIL=your-pgadmin-email-here
PGADMIN_PASSWORD=your-pgadmin-password-here

# CLOUDFLARE TURNSTILE (bot protection)
# Dev + staging: use official test keys below (always pass, no widget needed)
# Production: replace with real keys from dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# CORS
CORS_ORIGINS=http://localhost:46848,http://127.0.0.1:46848

# WEBMASTER (seed.ts first admin — password in CREDENTIALS.md)
WEBMASTER_EMAIL=bonitobonita24@gmail.com
WEBMASTER_PASSWORD=your-webmaster-password-here

# OBSERVABILITY
GLITCHTIP_DSN=

# TRAEFIK (staging + prod only)
# TRAEFIK_NETWORK=proxy
# APP_DOMAIN=yelli.app

# DOCKER IMAGE
DOCKERHUB_USERNAME=powerbyteit
IMAGE_NAME=yelli
APP_IMAGE_TAG=dev-latest
