# ═══════════════════════════════════════════════════════════════════
# Yelli LAN Edition — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════
# HOW TO USE:
#   This file is the template for .env.lan.
#   DO NOT edit .env.lan.example directly for secrets.
#   The real .env.lan is GENERATED by deploy/lan/install.sh:
#     - LAN_IP is auto-detected (or pass --ip <addr>)
#     - Every __generated_at_install__ value is replaced with a fresh
#       random secret using openssl rand. Secrets never leave this machine.
#
# NEVER commit .env.lan to git — it is already gitignored.
# NEVER share .env.lan (it contains real secrets).
#
# To re-generate secrets (e.g. after security incident):
#   deploy/lan/install.sh --force
# ═══════════════════════════════════════════════════════════════════

COMPOSE_PROJECT_NAME=yelli_lan
EDITION=lan

# LAN IP — auto-detected & overwritten by install.sh.
# Set this manually only if auto-detection picks the wrong interface.
LAN_IP=192.168.1.100

# ─── DATABASE ───────────────────────────────────────────────────────
DB_NAME=yelli_lan
DB_USER=yelli_lan
DB_PASSWORD=__generated_at_install__

# Internal Docker hostname used by app/worker containers.
# Do NOT change these — they reference the container name set by COMPOSE_PROJECT_NAME.
DATABASE_URL_INTERNAL=postgresql://${DB_USER}:${DB_PASSWORD}@${COMPOSE_PROJECT_NAME}_postgres:5432/${DB_NAME}

# DATABASE_URL exposed to the host (e.g. for migrations run outside compose).
# In LAN mode, postgres has no host port, so this only works from within the stack.
DATABASE_URL=${DATABASE_URL_INTERNAL}

# ─── CACHE (Valkey) ─────────────────────────────────────────────────
REDIS_PASSWORD=__generated_at_install__

# Internal Docker hostname.
REDIS_URL_INTERNAL=redis://default:${REDIS_PASSWORD}@${COMPOSE_PROJECT_NAME}_valkey:6379

REDIS_URL=${REDIS_URL_INTERNAL}

# ─── STORAGE (MinIO — S3-compatible) ────────────────────────────────
STORAGE_ACCESS_KEY=yelli-lan
STORAGE_SECRET_KEY=__generated_at_install__
STORAGE_ENDPOINT=http://${COMPOSE_PROJECT_NAME}_minio:9000
STORAGE_BUCKET=yelli-lan
STORAGE_REGION=us-east-1

# S3_* mirror set — Prisma schema and upload handlers use these names.
S3_ENDPOINT=http://${COMPOSE_PROJECT_NAME}_minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=yelli-lan
S3_SECRET_KEY=__generated_at_install__
S3_BUCKET_UPLOADS=yelli-lan-uploads
S3_BUCKET_EXPORTS=yelli-lan-exports
S3_BUCKET_BACKUPS=yelli-lan-backups

# ─── AUTH (Auth.js v5) ──────────────────────────────────────────────
# AUTH_SECRET must be ≥32 chars; install.sh generates ≥48 chars.
AUTH_SECRET=__generated_at_install__

# NEXTAUTH_URL is the HTTPS origin served by Caddy on the LAN IP.
# install.sh overwrites this with the detected LAN_IP.
NEXTAUTH_URL=https://${LAN_IP}

# ─── SIGNALING ──────────────────────────────────────────────────────
# Container always listens on 3001 internally.
# Caddy routes wss://<LAN_IP>/ws → signaling:3001.
SIGNALING_PORT=3001
SIGNALING_HEARTBEAT_TTL_SEC=30

# ─── CLIENT (public vars — baked into the Next.js build) ────────────
# These are compile-time values. If LAN_IP changes after the image was
# built, you must rebuild the app image with the new NEXT_PUBLIC_* values.
# For install-time flexibility, install.sh writes these to .env.lan;
# they are picked up at container start via Next.js runtime config.
NEXT_PUBLIC_SIGNALING_URL=wss://${LAN_IP}/ws

# Cloudflare Turnstile — LAN edition uses the always-pass test key.
# No internet access required; the widget is effectively bypassed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Web Push — generate VAPID keys once and store in CREDENTIALS.md.
# Leave blank to disable push notifications in LAN mode.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@yelli.lan

# ─── IMAGE TAGS (loaded from offline bundle) ─────────────────────────
# These tags are assigned by bundle.sh. Do not change unless you
# re-tag the images manually.
APP_IMAGE_TAG=lan
SIGNALING_IMAGE_TAG=lan
WORKER_IMAGE_TAG=lan
