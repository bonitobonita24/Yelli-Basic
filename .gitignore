# Per-machine Claude Code state (project skills, scan results, settings)
.claude/

# SpecStory session artifacts (generated locally, never committed)
.specstory/history/
.specstory/statistics.json

# Node
node_modules/

# Self-signed TLS certs — generated locally, never committed (private key!)
certs/

# Per-install runtime data: branding + logo uploads, service logs, update-source clone
data/
logs/
.update-source/

# ─── Build + TypeScript cache (Spec-Driven V32) ───
*.tsbuildinfo

# ─── Environment files — NEVER commit real credentials ───
.env
.env.*
!.env.example

# ─── Credentials master list ───
CREDENTIALS.md

# ─── AI Artifacts: Machine-Local Only (never commit) ───
.specstory/
project.memory.md
.code-review-graph/
.socraticodecontextartifacts.json
.github/skills/**/node_modules/
skills-lock.json

# ─── Third-Party AI Tool Artifacts (safety net) ───
.agents/
.cursor/
.windsurf/
.aider*
.copilot/
.continue/
.tabby/
.augment/
.roo/

