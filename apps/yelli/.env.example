# ───────────────────────────────────────────────────────
# apps/yelli — environment variables (Part 5 scaffold)
# Copy to .env.dev and fill from CREDENTIALS.md
# ───────────────────────────────────────────────────────

# Database (PgBouncer pooler)
DATABASE_URL=postgresql://yelli_dev:CHANGE_ME@localhost:46839/yelli_dev?schema=public&pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://yelli_dev:CHANGE_ME@localhost:46838/yelli_dev?schema=public

# Auth.js v5
AUTH_SECRET=CHANGE_ME_48_CHARS
NEXTAUTH_URL=http://localhost:46848
AUTH_TRUST_HOST=true

# Webmaster seed (used by packages/db/prisma/seed.ts)
WEBMASTER_EMAIL=bonitobonita24@gmail.com
WEBMASTER_PASSWORD=CHANGE_ME_22_CHARS_MIN

# Valkey (cache + BullMQ + Web Push subscription store)
REDIS_URL=redis://default:CHANGE_ME@localhost:46840

# Storage (MinIO dev)
S3_ENDPOINT=http://localhost:46841
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_UPLOADS=yelli-dev-uploads
S3_BUCKET_EXPORTS=yelli-dev-exports
S3_BUCKET_BACKUPS=yelli-dev-backups

# SMTP (MailHog dev)
SMTP_HOST=localhost
SMTP_PORT=46843
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Yelli <noreply@yelli.app>

# Turnstile (Cloudflare bot protection — Cloud only)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Web Push (VAPID — generate with `npx web-push generate-vapid-keys`)
WEB_PUSH_PUBLIC_KEY=CHANGE_ME
WEB_PUSH_PRIVATE_KEY=CHANGE_ME
WEB_PUSH_SUBJECT=mailto:oncall@powerbyteitsolutions.com

# LAN mode (anonymous admin)
LAN_MODE_ENABLED=false
LAN_DEFAULT_TENANT_SLUG=default

# Node
NODE_ENV=development
